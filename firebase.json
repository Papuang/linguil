{
  "firestore": {
    "database": "(default)",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "rm -rf functions/data && cp -r public/data functions/data",
        "rm -rf src/shared/data && cp -r public/data src/shared/data",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        ".gitignore",
        "firebase-debug*.log",
        "*.log",
        "src/**",
        "tsconfig.json",
        "eslint.config.js"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "functions/**",
      "apphosting.yaml"
    ]
  }
}